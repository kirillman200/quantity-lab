<table>
<thead><tr><th scope="col">Ceiling plane</th><th scope="col">Length along ridge</th><th scope="col">Sloped width</th><th scope="col">Painted area</th></tr></thead>
<tbody>
<tr><th scope="row">Left</th><td>20 ft / 6.096 m</td><td>10 ft / 3.048 m</td><td>200 sq ft / 18.58 m²</td></tr>
<tr><th scope="row">Right</th><td>20 ft / 6.096 m</td><td>10 ft / 3.048 m</td><td>200 sq ft / 18.58 m²</td></tr>
<tr><th scope="row">Total</th><td></td><td></td><td>400 sq ft / 37.16 m²</td></tr>
