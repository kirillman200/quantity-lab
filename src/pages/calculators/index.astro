---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorCard from '../../components/CalculatorCard.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { calculators, absolute } from '../../data/site';
const jsonLd = { '@type': 'CollectionPage', name: 'Home Project Calculators', url: absolute('/calculators/'), hasPart: [
  { '@type': 'WebApplication', name: 'Paint Coverage Calculator', url: absolute('/calculators/paint-coverage/') },
  ...calculators.map((c) => ({ '@type': 'WebApplication', name: c.name, url: absolute(`/calculators/${c.slug}/`) })),
] };
---
<BaseLayout title="Home Project Calculators" description="Choose a product-neutral calculator for paint coverage, room paint, floors, landscaping, concrete, or fencing." path="/calculators/" jsonLd={jsonLd}>
  <header class="page-hero"><div class="shell"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>Calculators</span></nav><p class="eyebrow">Project planners</p><h1>What are you building next?</h1><p class="lead">Choose a calculator, add every project area, set the package coverage and local price, then save, share, or print the result.</p></div></header>
  <section class="section"><div class="shell calculator-grid"><a class="tool-card" href="/calculators/paint-coverage/" style="--accent:#d6532f"><span class="number">01</span><span class="arrow" aria-hidden="true">↗</span><div class="tool-icon"><ToolIcon type="paint" /></div><h3>Paint coverage</h3><p>Gallons, quarts, litres, and spray cans</p></a>{calculators.map((calculator, index) => <CalculatorCard calculator={calculator} index={index + 1} />)}</div></section>
  <div class="shell"><div class="ad-slot print-hidden" aria-label="Reserved ad space"><span>Reserved ad space</span></div></div>
  <section class="section section-dark"><div class="shell"><div class="section-head"><div><p class="eyebrow">A safer estimate</p><h2>Know what the total assumes.</h2></div><p>Results use the dimensions and product data you provide. They remain planning estimates—not structural design, code approval, or a substitute for manufacturer instructions.</p></div></div></section>
</BaseLayout>
